create table "user" (
    "id" serial primary key,
    "fullname" varchar (80),
    "email" varchar (80) unique,
    "password" varchar (80),
    "address" varchar (80),
    "phone" varchar (15),
    "picture" varchar (255)
);

create table "products" (
    "id" serial primary key,
    "name" varchar (80),
    "description" varchar (100),
    "price" int,
    "quantity" int
);

create table "cart" (
    "id" serial primary key,
    "user_id" int references "user"("id"),
    "quantity" int,
    "product_id" int references "products"("id")
);

create table "transaction" (
    "id" serial primary key,
    "transaction_id" varchar(20) unique,
    "user_id" int references "user"("id"),
    "delivery_method" varchar(20),
    "subtotal" int,
    "delivery_fee" int, 
    "tax" int,
    "total" int,
    "date" date default current_date,
    "status" varchar, 
    "payment_method" varchar
);

create table "transaction_product" (
    "id" serial primary key,
    "transaction_id" varchar(20) references "transaction"("transaction_id"),
    "product_id" int references "products"("id"),
    "quantity" int,
    "size" varchar (10),
    "variant" varchar (10),
    "price" int
);

create table discount (
    "id" serial primary key,
    "product_id" int references "products"("id"),
    "isFlahSale" boolean,
    "discount_rate" float, 
    "disc_destribution" varchar (100)
);

create table product_variant (
    "id" serial primary key,
    "product_id" int references "products"("id"),
    "varian_name" varchar (80),
    "add_price" int
);

create table "review" (
    "id" serial primary key,
    "product_id" int references "products"("id"),
    "user_id" int references "user"("id"),
    "review_description" varchar (255),
    "rating" float
);

create table "category" (
    "id" serial primary key,
    "name" varchar (50)
);

create table "product_category"(
    "product_id" int references "products"("id"),
    "category_id" int references "category"("id"),
    primary key ("product_id", "cetegory_id")
);


create table "product_size" (
    "id" serial primary key,
    "product_id" int references "products"("id")
    "size_name" varchar (10),
);

create table "product_images" (
    "id" serial primary key,
    "product_id" int references "products"("id"),
    "image_url" varchar (255)
);


